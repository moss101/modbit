         {
          "op": "SetValue",
          "target": "saved",
          "value": "saved"
         }
        ]
       }
      },
      {
       "id": "style",
       "role": "label",
       "name": "Style",
       "value": "plain",
       "bounds": {
        "x": 40,
        "y": 600,
        "width": 300,
        "height": 30
       }
      },
      {
       "id": "saved",
       "role": "label",
       "name": "Saved state",
       "value": "unsaved",
       "bounds": {
        "x": 400,
        "y": 600,
        "width": 300,
        "height": 30
       }
      }
     ]
    }
   ]
  }
 ]
