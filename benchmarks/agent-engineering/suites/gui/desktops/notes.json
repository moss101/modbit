     "focused": false,
     "elements": [
      {
       "id": "bold",
       "role": "button",
       "name": "Bold",
       "actions": [
        "press"
       ],
       "bounds": {
        "x": 40,
        "y": 20,
        "width": 80,
        "height": 30
       },
       "behaviors": {
        "press": [
         {
          "op": "SetValue",
          "target": "style",
          "value": "bold"
         }
        ]
       }
      },
      {
       "id": "body",
       "role": "textarea",
       "name": "Document",
       "value": "",
       "settable": true,
       "focused": true,
       "actions": [
        "focus"
       ],
       "bounds": {
        "x": 40,
        "y": 80,
        "width": 1200,
        "height": 500
       },
       "behaviors": {
