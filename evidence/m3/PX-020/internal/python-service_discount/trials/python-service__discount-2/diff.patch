 """Fixture service (docs/50): a small module with a real pytest suite."""
 
+from decimal import ROUND_HALF_UP, Decimal
+
 
 def parse_quantity(text: str) -> int:
     """Parse a positive integer quantity; negative values are rejected."""
@@ -15,3 +17,15 @@ def total_cents(quantity: int, unit_cents: int) -> int:
 
 def format_cents(cents: int) -> str:
     return f"${cents // 100}.{cents % 100:02d}"
+
+
+def apply_discount(cents: int, percent: int) -> int:
+    """Return the amount after a percent discount, in cents.
+
+    The result is rounded half up to the nearest cent. percent must be
+    within 0..100; anything else raises ValueError.
+    """
+    if percent < 0 or percent > 100:
+        raise ValueError("percent must be between 0 and 100")
+    discounted = Decimal(cents) * (100 - percent) / Decimal(100)
+    return int(discounted.quantize(Decimal("1"), rounding=ROUND_HALF_UP))
