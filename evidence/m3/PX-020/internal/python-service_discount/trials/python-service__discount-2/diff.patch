+import pytest
+
+from service import apply_discount, format_cents, parse_quantity, total_cents
 
 
 def test_parse_quantity_rejects_negative():
@@ -11,3 +13,31 @@ def test_parse_quantity_rejects_negative():
 
 def test_total_and_format():
     assert format_cents(total_cents(parse_quantity("3"), 250)) == "$7.50"
+
+
+def test_apply_discount_examples():
+    assert apply_discount(1000, 15) == 850
+    assert apply_discount(999, 33) == 669
+    assert apply_discount(101, 50) == 51
+
+
+def test_apply_discount_bounds_of_percent():
+    assert apply_discount(1000, 0) == 1000
+    assert apply_discount(1000, 100) == 0
+
+
+def test_apply_discount_rounds_half_up():
+    # 999 * 50% = 499.5 cents -> 500
+    assert apply_discount(999, 50) == 500
+    # 5 * 10% = 4.5 cents -> 5 (ties round up, not to even)
+    assert apply_discount(5, 10) == 5
+    # 15 * 10% = 13.5 cents -> 14
+    assert apply_discount(15, 10) == 14
+    # 101 * 67% = 67.67 cents -> 68
+    assert apply_discount(101, 33) == 68
+
+
+def test_apply_discount_rejects_percent_out_of_range():
+    for bad_percent in (-1, 101, 1000):
+        with pytest.raises(ValueError):
+            apply_discount(1000, bad_percent)
