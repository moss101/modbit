+def test_apply_discount_basic():
+    assert apply_discount(1000, 15) == 850
+    assert apply_discount(999, 33) == 669
+
+
+def test_apply_discount_rounds_half_up():
+    # 101 cents at 50% off is 50.5 cents -> rounds half up to 51
+    assert apply_discount(101, 50) == 51
+    # 101 cents at 49% off is 51.51 cents -> rounds half up to 52
+    assert apply_discount(101, 49) == 52
+
+
+def test_apply_discount_bounds():
+    assert apply_discount(1000, 0) == 1000
+    assert apply_discount(1000, 100) == 0
+
+
+def test_apply_discount_rejects_out_of_range_percent():
+    for bad_percent in (-1, 101):
+        try:
+            apply_discount(1000, bad_percent)
+        except ValueError:
+            continue
+        raise AssertionError(f"percent {bad_percent} accepted")
