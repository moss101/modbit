diff --git a/service.py b/service.py
index 91ac956..f4f89bb 100644
--- a/service.py
+++ b/service.py
@@ -15,3 +15,18 @@ def total_cents(quantity: int, unit_cents: int) -> int:
 
 def format_cents(cents: int) -> str:
     return f"${cents // 100}.{cents % 100:02d}"
+
+
+def apply_discount(cents: int, percent: int) -> int:
+    """Return the amount after a percentage discount, in cents.
+
+    Rounds half up to the nearest cent using integer math:
+    ``cents * (100 - percent)`` is in hundredths of a cent, so adding 50
+    before floor division implements round-half-up (also for negative
+    inputs, given Python's floor division).
+
+    Raises ValueError when percent is below 0 or above 100.
+    """
+    if percent < 0 or percent > 100:
+        raise ValueError("percent must be between 0 and 100")
+    return (cents * (100 - percent) + 50) // 100
