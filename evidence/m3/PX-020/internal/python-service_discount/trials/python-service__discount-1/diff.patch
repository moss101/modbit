diff --git a/service.py b/service.py
index 91ac956..0b8704e 100644
--- a/service.py
+++ b/service.py
@@ -15,3 +15,21 @@ def total_cents(quantity: int, unit_cents: int) -> int:
 
 def format_cents(cents: int) -> str:
     return f"${cents // 100}.{cents % 100:02d}"
+
+
+def apply_discount(cents: int, percent: int) -> int:
+    """Return ``cents`` after a ``percent`` discount, rounded half up.
+
+    Raises ValueError when percent is below 0 or above 100.
+
+    >>> apply_discount(1000, 15)
+    850
+    >>> apply_discount(999, 33)
+    669
+    >>> apply_discount(101, 50)
+    51
+    """
+    if percent < 0 or percent > 100:
+        raise ValueError("percent must be between 0 and 100")
+    discounted = cents * (100 - percent) * 2
+    return (discounted + 100) // 200
