 /// Human formatting of a cent amount.
+///
+/// Negative amounts render with a single leading minus and two-digit cents
+/// (e.g. -105 -> "-1.05", -5 -> "-0.05"); positive output is unchanged.
 pub fn format_cents(cents: i64) -> String {
-    format!("{}.{:02}", cents / 100, cents % 100)
+    let sign = if cents < 0 { "-" } else { "" };
+    let mag = cents.unsigned_abs();
+    format!("{}{}.{:02}", sign, mag / 100, mag % 100)
